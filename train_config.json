{
  "data_file": "dataset/conll04.pkl",
  "model_name": "scibert_cased",
  "max_width": 14,
  "num_prompts": 5,
  "hidden_transformer": 512,
  "num_transformer_layers": 6,
  "attention_heads": 8,
  "span_mode": "conv_share",
  "p_drop": 0.1,
  "use_pos_code": true,
  "n_epochs": 1,
  "n_steps": 10000,
  "batch_size": 1,
  "eval_batch_size": 1,
  "lr_encoder": 1e-5,
  "lr_decoder": 1e-4,
  "lr_others": 5e-4,
  "warmup_ratio": 0.1,
  "grad_accumulation_steps": 1,
  "save_interval": 1000,
  "max_num_samples": 1,
  "log_dir": "logs",
  "cross_attn": true
}
